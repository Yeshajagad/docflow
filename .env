# Local dev default: SQLite, no external services needed
DATABASE_URL=sqlite:///./docflow.db

# Full cluster mode (uncomment when using docker-compose / Postgres):
# DATABASE_URL=postgresql://docflow:docflow@postgres:5432/docflow

# Redis for heartbeats. Leave unset to use the in-memory fallback locally.
# REDIS_URL=redis://redis:6379/0

# Scheduling
DEFAULT_SCHEDULING_POLICY=best_fit   # first_fit | best_fit | fair_share

# Heartbeats / failover
HEARTBEAT_TTL_SECONDS=15
RECONCILE_INTERVAL_SECONDS=5
MAX_RETRIES=3

NODE_ID=node-1
